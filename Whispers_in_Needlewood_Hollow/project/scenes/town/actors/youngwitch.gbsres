          {
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "Hello ,\nLittle Witch.\nIt's always nice\nto see you.",
                "I see.. your bunny\nis broken?",
                "I'm afraid I don't\nhave a needle and\nthread. However...",
                "You listen \nclosely.",
                "If you search the \nforest for some\ncotton seeds, and \na big enough rock.",
                "You can take the\nmaterials to the\nElder Witch.",
                "She lives in \nseclusion, south \nof here, off the\nbeaten path.",
                "I'm sure she can \nmake you a needle\nand thread.",
                "You didn't hear \nthat from me,\nteehee.",
                "Here, take these."
              ],
              "__section": "text",
              "avatarId": "",
